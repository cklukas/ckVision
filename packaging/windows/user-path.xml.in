<CPackWiXPatch>
  <CPackWiXFragment Id="#PRODUCT">
    <Property Id="CKVISION_PREVIOUS_ROOT" Secure="yes">
      <RegistrySearch Id="CkVisionInstallRoot" Root="HKCU"
                      Key="Software\ckvision\@CKVISION_PACKAGE_WINDOWS_ARCH@"
                      Name="InstallRoot" Type="raw" Bitness="always64" />
    </Property>
    <SetProperty Id="INSTALL_ROOT" Value="[CKVISION_PREVIOUS_ROOT]"
                 Before="CostFinalize" Condition="NOT INSTALL_ROOT AND CKVISION_PREVIOUS_ROOT" />
    <DirectoryRef Id="CM_DP_bin">
      <Component Id="CkVisionUserPath" Guid="@CKVISION_PACKAGE_PATH_GUID@">
        <Environment Id="CkVisionPath" Name="PATH" Value="[INSTALL_ROOT]bin"
                     Action="set" Part="last" System="no" Permanent="no" />
        <RegistryValue Root="HKCU" Key="Software\ckvision\@CKVISION_PACKAGE_WINDOWS_ARCH@"
                       Name="InstallRoot" Value="[INSTALL_ROOT]" Type="string" KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </CPackWiXFragment>
  <CPackWiXFragment Id="#PRODUCTFEATURE">
    <ComponentRef Id="CkVisionUserPath" />
  </CPackWiXFragment>
</CPackWiXPatch>

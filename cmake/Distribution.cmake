# Package the complete framework SDK and every supported example.
set(CPACK_PACKAGE_NAME "ckvision")
set(CPACK_PACKAGE_VENDOR "C. Klukas")
set(CPACK_PACKAGE_CONTACT "C. Klukas <christian.klukas@gmail.com>")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "C++ terminal desktop framework, developer SDK and example applications")
set(CPACK_PACKAGE_HOMEPAGE_URL "https://github.com/cklukas/ckVision")
set(CPACK_PACKAGE_VERSION "${PROJECT_VERSION}")
set(CPACK_RESOURCE_FILE_LICENSE "${PROJECT_SOURCE_DIR}/LICENSE")
set(CPACK_PACKAGE_CHECKSUM SHA256)
set(CPACK_STRIP_FILES TRUE)
set(CPACK_INSTALL_CMAKE_PROJECTS "${CMAKE_BINARY_DIR};${PROJECT_NAME};ALL;/")
set(CPACK_MONOLITHIC_INSTALL ON)
set(CPACK_PACKAGE_FILE_NAME "ckvision-${PROJECT_VERSION}-${CMAKE_SYSTEM_NAME}-${CMAKE_SYSTEM_PROCESSOR}")
set(CPACK_PROJECT_CONFIG_FILE "${PROJECT_SOURCE_DIR}/cmake/PackageGenerator.cmake")
set(CPACK_DEBIAN_PACKAGE_SECTION "utils")
set(CPACK_DEBIAN_PACKAGE_SHLIBDEPS ON)
set(CPACK_DEBIAN_PACKAGE_DEPENDS "openssh-client")
set(CPACK_DEBIAN_FILE_NAME DEB-DEFAULT)
set(CPACK_RPM_PACKAGE_LICENSE "MIT")
set(CPACK_RPM_PACKAGE_GROUP "Applications/System")
set(CPACK_RPM_PACKAGE_AUTOREQ ON)
set(CPACK_RPM_PACKAGE_REQUIRES "openssh-clients")
set(CPACK_RPM_FILE_NAME RPM-DEFAULT)
if(WIN32)
    set(CKVISION_PACKAGE_WINDOWS_ARCH x64)
    if(CMAKE_GENERATOR_PLATFORM MATCHES "[Aa][Rr][Mm]64" OR
       CMAKE_CXX_COMPILER_ARCHITECTURE_ID MATCHES "[Aa][Rr][Mm]64")
        set(CKVISION_PACKAGE_WINDOWS_ARCH arm64)
    endif()
    set(CPACK_GENERATOR ZIP)
    set(CPACK_PACKAGE_FILE_NAME "ckvision-${PROJECT_VERSION}-Windows-${CKVISION_PACKAGE_WINDOWS_ARCH}")
    set(CPACK_PACKAGE_INSTALL_DIRECTORY "ckvision-${CKVISION_PACKAGE_WINDOWS_ARCH}")
    set(CPACK_WIX_VERSION 4)
    set(CPACK_WIX_ARCHITECTURE "${CKVISION_PACKAGE_WINDOWS_ARCH}")
    set(CPACK_WIX_INSTALL_SCOPE perUser)
    set(CPACK_WIX_COMPONENT_KEYS_REGISTRY_PATH "Software/ckvision/${CKVISION_PACKAGE_WINDOWS_ARCH}/Components")
    set(CPACK_PACKAGE_EXECUTABLES "ck-sysmon;ck-sysmon")
    string(UUID CPACK_WIX_UPGRADE_GUID NAMESPACE 0082B366-DF40-4CEB-BEE6-A97421E837AC
        NAME "ckvision-${CKVISION_PACKAGE_WINDOWS_ARCH}" TYPE SHA1 UPPER)
    string(UUID CKVISION_PACKAGE_PATH_GUID NAMESPACE "${CPACK_WIX_UPGRADE_GUID}"
        NAME "user-path" TYPE SHA1 UPPER)
    set(CPACK_CKVISION_STATIC_CRT FALSE)
    if(CMAKE_MSVC_RUNTIME_LIBRARY STREQUAL "MultiThreaded")
        set(CPACK_CKVISION_STATIC_CRT TRUE)
    endif()
    set(CPACK_CKVISION_WINDOWS TRUE)
    file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/packaging")
    configure_file("${PROJECT_SOURCE_DIR}/packaging/windows/user-path.xml.in"
        "${CMAKE_BINARY_DIR}/packaging/user-path.xml" @ONLY)
    set(CPACK_WIX_PATCH_FILE "${CMAKE_BINARY_DIR}/packaging/user-path.xml")
    configure_file("${PROJECT_SOURCE_DIR}/LICENSE" "${CMAKE_BINARY_DIR}/packaging/LICENSE.txt" COPYONLY)
    set(CPACK_RESOURCE_FILE_LICENSE "${CMAKE_BINARY_DIR}/packaging/LICENSE.txt")
else()
    set(CPACK_GENERATOR TGZ)
endif()
if(APPLE)
    # macOS provenance/resource-fork attributes are host metadata, not payload.
    configure_file("${PROJECT_SOURCE_DIR}/cmake/PackageArchive.cmake.in"
        "${CMAKE_BINARY_DIR}/PackageArchive.cmake" @ONLY)
    set(CPACK_POST_BUILD_SCRIPTS "${CMAKE_BINARY_DIR}/PackageArchive.cmake")
endif()
include(CPack)

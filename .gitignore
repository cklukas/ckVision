build*/
.cache/
compile_commands.json
.DS_Store
*.o
*.a
__pycache__/
# Generated by tools/docgen/generate_docs.sh — regenerate, never hand-edit.
#
# The example screenshots are the one exception. Eleven documentation pages
# embed them, so a clone without them renders eleven pages of broken images;
# they are tracked and published, and regenerated in place. Everything else
# under generated/ — the HTML and PDF renders, the TeX intermediates, the
# rsvg PDF conversions of the screenshots — stays local.
docs/generated/*
!docs/generated/screenshots/
docs/generated/screenshots/*
!docs/generated/screenshots/*.svg

# Comparison captures against a Turbo Vision hello. No documentation page
# references them, and this project does not publish them.
docs/generated/screenshots/tvhello-*.svg

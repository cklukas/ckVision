foreach(required IN ITEMS CKVISION_BUILD_DIR CKVISION_CLIENT_DIR CKVISION_CXX_COMPILER CKVISION_RECIPE_DIR)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "log_client_install requires ${required}")
    endif()
endforeach()
if(NOT IS_ABSOLUTE "${CKVISION_CLIENT_DIR}")
    message(FATAL_ERROR "caller must select an absolute client/scratch workspace")
endif()
set(prefix "${CKVISION_CLIENT_DIR}/prefix")
set(consumer "${CKVISION_CLIENT_DIR}/consumer")
file(MAKE_DIRECTORY "${CKVISION_CLIENT_DIR}/scratch")
execute_process(COMMAND "${CMAKE_COMMAND}" --install "${CKVISION_BUILD_DIR}"
    --config "${CKVISION_CONFIG}" --component Development --prefix "${prefix}"
    RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "SDK-only installation failed: ${result}")
endif()
set(arguments -S "${prefix}/${CKVISION_RECIPE_DIR}" -B "${consumer}"
    "-DCMAKE_PREFIX_PATH=${prefix}" "-DCMAKE_CXX_COMPILER=${CKVISION_CXX_COMPILER}"
    "-DCMAKE_BUILD_TYPE=${CKVISION_CONFIG}" "-DLOG_CLIENT_SCRATCH=${CKVISION_CLIENT_DIR}/scratch")
if(DEFINED CKVISION_CONSUMER_GENERATOR AND NOT CKVISION_CONSUMER_GENERATOR STREQUAL "")
    list(APPEND arguments -G "${CKVISION_CONSUMER_GENERATOR}")
endif()
if(DEFINED CKVISION_CONSUMER_PLATFORM AND NOT CKVISION_CONSUMER_PLATFORM STREQUAL "")
    list(APPEND arguments -A "${CKVISION_CONSUMER_PLATFORM}")
endif()
if(DEFINED CKVISION_CONSUMER_TOOLSET AND NOT CKVISION_CONSUMER_TOOLSET STREQUAL "")
    list(APPEND arguments -T "${CKVISION_CONSUMER_TOOLSET}")
endif()
if(DEFINED CKVISION_CONSUMER_INSTANCE AND NOT CKVISION_CONSUMER_INSTANCE STREQUAL "")
    list(APPEND arguments "-DCMAKE_GENERATOR_INSTANCE=${CKVISION_CONSUMER_INSTANCE}")
endif()
if(DEFINED CKVISION_MSVC_RUNTIME_LIBRARY AND NOT CKVISION_MSVC_RUNTIME_LIBRARY STREQUAL "")
    list(APPEND arguments "-DCMAKE_MSVC_RUNTIME_LIBRARY=${CKVISION_MSVC_RUNTIME_LIBRARY}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" ${arguments} RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "installed log-client configuration failed: ${result}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${consumer}" --config "${CKVISION_CONFIG}" --parallel 2 RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "installed log-client compilation failed: ${result}")
endif()
execute_process(COMMAND "${CMAKE_CTEST_COMMAND}" --test-dir "${consumer}" -C "${CKVISION_CONFIG}" --output-on-failure RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "installed public log-client execution failed: ${result}")
endif()
